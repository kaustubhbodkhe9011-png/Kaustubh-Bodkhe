# ============================================================
# Frontend Environment Variables (.env)
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# Backend API URL (set after deploying server/)
# Leave blank to use Formspree or mailto fallback
VITE_API_URL=

# Formspree form ID (fallback if no backend)
# Get it from https://formspree.io
VITE_FORMSPREE_ID=
